# === API ===
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://127.0.0.1:9090

# Docker (default): PostgreSQL — см. POSTGRES_PASSWORD ниже
# DATABASE_URL=postgresql+psycopg2://hh:hh@db:5432/hh_agent
POSTGRES_PASSWORD=change-me-strong-password

# Локально без Docker / sqlite-compose:
# DATABASE_URL=sqlite:///./data/hh_agent.db

# === Telegram bot ===
BOT_TOKEN=
# Local venv/scripts: 127.0.0.1; Docker overrides in docker-compose.yml
TELEGRAM_PROXY=socks5://127.0.0.1:10808

# === OpenRouter AI ===
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001
OPENROUTER_RETRY_ATTEMPTS=3
OPENROUTER_RETRY_DELAY_SEC=2
AI_REQUEST_DELAY_SEC=1
VACANCY_RESULTS_COUNT=7
VACANCY_HH_PAGE_SIZE=20
VACANCY_MAX_HH_PAGES=5

# === hh.ru API ===
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Must match dev.hh.ru exactly (localhost, not 127.0.0.1)
HH_REDIRECT_URI=http://localhost:8000/auth/callback
AUTO_APPLY_MIN_MATCH=70
AUTO_APPLY_DAILY_LIMIT=10
HH_USER_AGENT=hh-ai-agent/1.0 (your_email@gmail.com)

# === Admin (your Telegram ID from @userinfobot) ===
ADMIN_API_KEY=change-me-to-random-string
ADMIN_TELEGRAM_IDS=123456789
# Bot commands: /admin /pro /reset_me /stats /activate_pro ID /user ID

# === Promo codes (CODE:plan, comma-separated) ===
PROMO_CODES=LAUNCH2026:pro,FRIEND:pro

# === Pro pricing ===
PRO_PRICE_RUB=490
PRO_CONTACT=@your_username

# === Public URL (HTTPS, for YooKassa webhook) ===
PUBLIC_URL=https://api.your-domain.ru
BOT_USERNAME=HHSearchVacanciesBot

# === YooKassa (auto Pro after payment) ===
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# === Referrals ===
REFERRAL_BONUS_SEARCHES=3

# === Digest ===
DIGEST_HOUR_MSK=9
